# Install only after confirming a separate hostname, DNS, TLS certificate and Basic Auth file.
server {
    listen 80;
    server_name __PREVIEW_HOST__;
    return 301 https://__PREVIEW_HOST__$request_uri;
}
server {
    listen 443 ssl;
    server_name __PREVIEW_HOST__;
    ssl_certificate __PREVIEW_FULLCHAIN__;
    ssl_certificate_key __PREVIEW_TLS_KEY__;
    auth_basic "Orkidea Vue preview";
    auth_basic_user_file __PREVIEW_HTPASSWD__;
    client_max_body_size 6m;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    location /health/ { return 404; }
    location / {
        proxy_pass http://127.0.0.1:__PREVIEW_LOOPBACK_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization "";
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }
}
