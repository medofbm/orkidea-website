# Fill only after reviewing the existing host Nginx configuration and staging TLS certificate.
server {
    listen 80;
    server_name staging.orkidea.ly;
    location /.well-known/acme-challenge/ { root /var/www/orkidea-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name staging.orkidea.ly;
    ssl_certificate /etc/letsencrypt/live/staging.orkidea.ly/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.orkidea.ly/privkey.pem;
    auth_basic "Orkidea preview";
    auth_basic_user_file /etc/nginx/orkidea-staging.htpasswd;
    client_max_body_size 6m;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    location /health/ { return 404; }
    location / {
        proxy_pass http://127.0.0.1:__VERIFIED_LOOPBACK_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }
}
