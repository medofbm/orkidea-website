# Optional outer rate limit (F-13). To enable: put the zone line in the http{} context
# (for example /etc/nginx/conf.d/orkidea-limits.conf) and uncomment the two lines in the server below.
# limit_req_zone $binary_remote_addr zone=orkidea_api:10m rate=10r/s;
# Fill only after reviewing the existing host Nginx configuration and staging TLS certificate.
server {
    listen 80;
    server_name staging.orkidea.ly;
    location /.well-known/acme-challenge/ { root /var/www/orkidea-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name staging.orkidea.ly;
    ssl_certificate /etc/letsencrypt/live/staging.orkidea.ly/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.orkidea.ly/privkey.pem;
    auth_basic "Orkidea preview";
    auth_basic_user_file /etc/nginx/orkidea-staging.htpasswd;
    client_max_body_size 6m;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
    # The Nuxt app sets the enforced Content-Security-Policy itself (frontend/server/middleware/security-headers.ts).
    # location /api/ {
    #     limit_req zone=orkidea_api burst=20 nodelay;
    #     limit_req_status 429;
    #     proxy_pass http://127.0.0.1:__LOOPBACK_PORT__;  # same proxy_* lines as "location /" below
    # }
    location /health/ { return 404; }
    location / {
        proxy_pass http://127.0.0.1:__VERIFIED_LOOPBACK_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization "";
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }
}
