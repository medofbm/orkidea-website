@model Product

@{
    var defaultVariant = Model.ProductVariants.OrderBy(v => v.Price).First();
}

<div class="card h-100 shadow-sm product-card" style="border-radius:16px;overflow:hidden;border:none;">
    <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@Model.ProductId"
       class="text-decoration-none d-block position-relative">
        <img src="@Model.ImageUrl"
             class="card-img-top"
             alt="@Model.Name"
             style="height:180px;object-fit:cover;"
             onerror="this.src=''" />
        <div class="position-absolute top-0 end-0 m-2">
            <span class="badge" style="background:rgba(106,27,154,0.85);font-size:0.7rem;border-radius:12px;">
                <i class="fas fa-leaf me-1"></i>طبيعي
            </span>
        </div>
    </a>
    <div class="card-body d-flex flex-column p-3">
        <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@Model.ProductId"
           class="text-decoration-none">
            <h6 class="card-title fw-700 mb-1" style="color:#1a0533;font-size:0.92rem;line-height:1.4;">@Model.Name</h6>
        </a>

        <div class="price-display-@Model.ProductId fw-800 mb-2" style="color:#6a1b9a;font-size:1rem;">
            @defaultVariant.Price.ToString("0.00") <small class="fw-500" style="font-size:0.75rem;">د.ل</small>
        </div>

        <div class="variant-buttons mb-2 d-flex flex-wrap gap-1">
            @foreach (var variant in Model.ProductVariants.OrderBy(v => v.Price))
            {
                <button type="button"
                        class="btn btn-outline-primary variant-btn @(variant.ProductVariantId == defaultVariant.ProductVariantId ? "active" : "")"
                        data-price="@variant.Price.ToString("0.00")"
                        data-variant-id="@variant.ProductVariantId"
                        data-product-id="@Model.ProductId"
                        style="font-size:0.72rem;padding:0.25rem 0.6rem;border-radius:12px;">
                    @variant.Size
                </button>
            }
        </div>

        <button type="button"
                class="btn btn-primary w-100 mt-auto add-to-cart-btn"
                data-product-id="@Model.ProductId"
                data-variant-id="@defaultVariant.ProductVariantId"
                data-quantity="1"
                style="font-size:0.85rem;padding:0.5rem;border-radius:12px;">
            <i class="fas fa-cart-plus me-1"></i> أضف للسلة
        </button>
    </div>
</div>