@model Product

@{
    var defaultVariant = Model.ProductVariants.OrderBy(v => v.Price).First();
}

<div class="product-card-wrapper">
    @* صورة المنتج *@
    <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@Model.ProductId"
       class="product-card-img-link" aria-label="عرض تفاصيل @Model.Name">
        <div class="product-card-img-frame">
            <img src="@Model.ImageUrl"
                 class="product-card-img"
                 alt="@Model.Name"
                 loading="lazy"
                 onerror="this.onerror=null;this.parentElement.classList.add('img-error');this.style.display='none';" />
            <div class="product-card-img-overlay">
                <span class="product-view-btn">
                    <i class="fas fa-eye me-1"></i> عرض المنتج
                </span>
            </div>
        </div>
        <span class="product-natural-badge">
            <i class="fas fa-leaf"></i> طبيعي 100%
        </span>
    </a>

    @* محتوى البطاقة *@
    <div class="product-card-body">
        <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@Model.ProductId"
           class="text-decoration-none">
            <h6 class="product-card-title">@Model.Name</h6>
        </a>

        <div class="product-card-price-row">
            <span class="product-price-display price-display-@Model.ProductId">
                @defaultVariant.Price.ToString("0.00")
                <small class="price-currency">د.ل</small>
            </span>
        </div>

        <div class="variant-buttons d-flex flex-wrap gap-1 mb-3">
            @foreach (var variant in Model.ProductVariants.OrderBy(v => v.Price))
            {
                <button type="button"
                        class="variant-size-btn @(variant.ProductVariantId == defaultVariant.ProductVariantId ? "active" : "")"
                        data-price="@variant.Price.ToString("0.00")"
                        data-variant-id="@variant.ProductVariantId"
                        data-product-id="@Model.ProductId">
                    @variant.Size
                </button>
            }
        </div>

        <button type="button"
                class="add-to-cart-btn-styled add-to-cart-btn"
                data-product-id="@Model.ProductId"
                data-variant-id="@defaultVariant.ProductVariantId"
                data-quantity="1">
            <i class="fas fa-cart-plus"></i>
            <span>أضف للسلة</span>
        </button>
    </div>
</div>