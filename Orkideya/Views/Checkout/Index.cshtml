@model CheckoutViewModel
@using System.Globalization
@{
    ViewData["Title"] = "إتمام الطلب";
    string FieldInvalid(string field) => ViewData.ModelState.TryGetValue($"Input.{field}", out var state) && state.Errors.Count > 0 ? "true" : "false";
    var carrier = Model.HomeDestinations is not null;
    var selectedRate = Model.ShippingRates.FirstOrDefault(rate => rate.ShippingRateId == Model.Input.ShippingRateId);
    var displayedFee = carrier ? Model.QuotedFee : selectedRate?.Price;
    var shippingPrompt = carrier ? "احسب التوصيل" : "اختر المدينة";
}
<div class="checkout-container container py-4">
    <h1>إتمام الطلب</h1>
    <div class="row g-4">
        <div class="col-lg-7">
            <p class="alert alert-info" role="note">طلبك يخضع لتأكيد التوفر. لا تُحجز الكمية قبل مراجعتنا وتأكيد الطلب.</p>
            <form asp-action="PlaceOrder" method="post" id="checkoutForm">
                <input asp-for="Input.CheckoutToken" type="hidden" />
                <div asp-validation-summary="All" class="alert alert-danger" role="alert" id="checkoutErrors" tabindex="-1"></div>
                <div class="mb-3">
                    <label asp-for="Input.WhatsAppNumber" class="form-label">رقم الواتساب</label>
                    <input asp-for="Input.WhatsAppNumber" type="tel" inputmode="tel" dir="ltr" aria-describedby="error-WhatsAppNumber" aria-invalid="@FieldInvalid("WhatsAppNumber")" class="form-control" autocomplete="tel" maxlength="20" required />
                    <span asp-validation-for="Input.WhatsAppNumber" class="text-danger" id="error-WhatsAppNumber"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.FirstName" class="form-label">الاسم الأول</label>
                        <input asp-for="Input.FirstName" aria-describedby="error-FirstName" aria-invalid="@FieldInvalid("FirstName")" class="form-control" autocomplete="given-name" maxlength="50" required />
                        <span asp-validation-for="Input.FirstName" class="text-danger" id="error-FirstName"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.LastName" class="form-label">اسم العائلة</label>
                        <input asp-for="Input.LastName" aria-describedby="error-LastName" aria-invalid="@FieldInvalid("LastName")" class="form-control" autocomplete="family-name" maxlength="50" required />
                        <span asp-validation-for="Input.LastName" class="text-danger" id="error-LastName"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.ShippingAddress" class="form-label">العنوان بالتفصيل</label>
                    <textarea asp-for="Input.ShippingAddress" aria-describedby="error-ShippingAddress" aria-invalid="@FieldInvalid("ShippingAddress")" class="form-control" autocomplete="street-address" maxlength="200" rows="3" required></textarea>
                    <span asp-validation-for="Input.ShippingAddress" class="text-danger" id="error-ShippingAddress"></span>
                </div>
                @if (Model.HomeDestinations is { } destinations)
                {
                    <div class="mb-3">
                        <label asp-for="Input.CarrierDestination" class="form-label">المدينة والمنطقة</label>
                        <select asp-for="Input.CarrierDestination" class="form-select" required>
                            <option value="">اختر منطقة التوصيل</option>
                            @foreach (var destination in destinations.Where(pair => !pair.Value.IsPickup))
                            {
                                var service = destination.Value.Service switch { "women" => " — توصيل نسائي", "men" => " — توصيل رجالي", _ => "" };
                                <option value="@destination.Key">@destination.Value.City — @destination.Value.Area@service</option>
                            }
                        </select>
                        <input asp-for="Input.QuoteToken" type="hidden" />
                        <button type="submit" asp-action="PreviewShipping" formnovalidate class="btn btn-outline-primary mt-2">احسب التوصيل</button>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label for="shippingRateIdInput" class="form-label">مدينة التوصيل</label>
                        <select asp-for="Input.ShippingRateId" class="form-select" id="shippingRateIdInput" aria-describedby="error-ShippingRateId shippingCityHelp" aria-invalid="@FieldInvalid("ShippingRateId")" required>
                            <option value="">اختر مدينة التوصيل</option>
                            @foreach (var rate in Model.ShippingRates)
                            {
                                <option value="@rate.ShippingRateId" data-price="@rate.Price.ToString(CultureInfo.InvariantCulture)">@rate.CityName — @rate.Price.ToString("0.00") د.ل</option>
                            }
                        </select>
                        <span asp-validation-for="Input.ShippingRateId" class="text-danger" id="error-ShippingRateId"></span>
                        <p class="form-text" id="shippingCityHelp">الطلب متاح للمدن المدرجة فقط، وبتكلفة التوصيل الموضحة.</p>
                    </div>
                }
            </form>
        </div>
        <div class="col-lg-5">
            <div class="order-summary-box" id="checkoutSummary" data-subtotal="@Model.CartTotal.ToString(CultureInfo.InvariantCulture)">
                <h2 class="h4">ملخص الطلب</h2>
                @foreach (var item in Model.CartItems)
                {
                    <div class="summary-item">
                        <img src="@item.ImageUrl" alt="@item.ProductName" class="summary-item-img" />
                        <div class="summary-item-details">@item.ProductName <small>الكمية: @item.Quantity</small></div>
                        <div>@item.SubTotal.ToString("0.00") د.ل</div>
                    </div>
                }
                <hr />
                <p>إجمالي المنتجات: @Model.CartTotal.ToString("0.00") د.ل</p>
                <p>التوصيل: <span id="shippingTotal">@(displayedFee is { } fee ? fee.ToString("0.00") + " د.ل" : shippingPrompt)</span></p>
                <p class="summary-total" aria-live="polite">الإجمالي مع التوصيل: <span id="orderTotal">@(displayedFee is { } quoted ? (Model.CartTotal + quoted).ToString("0.00") + " د.ل" : shippingPrompt)</span></p>
                @if (!carrier)
                {
                    <noscript>اختر المدينة وراجع تكلفة التوصيل الموضحة بجانبها؛ تُضاف هذه التكلفة إلى إجمالي المنتجات.</noscript>
                }
                <button id="confirmCheckout" form="checkoutForm" disabled="@(carrier && Model.QuotedFee is null)" type="submit" class="btn btn-success btn-lg w-100 mt-3">تأكيد الطلب والدفع عند الاستلام</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/checkout.js" asp-append-version="true"></script>
}
