@model CheckoutViewModel
@using System.Globalization
@{
    ViewData["Title"] = "إتمام الطلب";
    var selectedRate = Model.ShippingRates.FirstOrDefault(rate => rate.ShippingRateId == Model.Input.ShippingRateId);
}
<div class="checkout-container">
    <h1>إتمام الطلب</h1>
    <div class="row g-4">
        <div class="col-lg-7">
            <p class="alert alert-info" role="note">طلبك يخضع لتأكيد التوفر. لا تُحجز الكمية قبل مراجعتنا وتأكيد الطلب.</p>
            <form asp-action="PlaceOrder" method="post" id="checkoutForm">
                <input asp-for="Input.CheckoutToken" type="hidden" />
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Input.WhatsAppNumber" class="form-label">رقم الواتساب</label>
                    <input asp-for="Input.WhatsAppNumber" type="tel" class="form-control" autocomplete="tel" maxlength="20" required />
                    <span asp-validation-for="Input.WhatsAppNumber" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.FirstName" class="form-label">الاسم الأول</label>
                        <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" maxlength="50" required />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.LastName" class="form-label">اسم العائلة</label>
                        <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" maxlength="50" required />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.ShippingAddress" class="form-label">العنوان بالتفصيل</label>
                    <textarea asp-for="Input.ShippingAddress" class="form-control" autocomplete="street-address" maxlength="200" rows="3" required></textarea>
                    <span asp-validation-for="Input.ShippingAddress" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.ShippingRateId" class="form-label">مدينة التوصيل</label>
                    <select asp-for="Input.ShippingRateId" class="form-select" id="shippingRateIdInput" required>
                        <option value="">اختر مدينة التوصيل</option>
                        @foreach (var rate in Model.ShippingRates)
                        {
                            <option value="@rate.ShippingRateId" data-price="@rate.Price.ToString(CultureInfo.InvariantCulture)">@rate.CityName — @rate.Price.ToString("0.00") د.ل</option>
                        }
                    </select>
                    <span asp-validation-for="Input.ShippingRateId" class="text-danger"></span>
                    <p class="form-text">الطلب متاح للمدن المدرجة فقط، وبتكلفة التوصيل الموضحة.</p>
                </div>
                <button type="submit" class="btn btn-success btn-lg w-100">تأكيد الطلب والدفع عند الاستلام</button>
            </form>
        </div>
        <div class="col-lg-5">
            <div class="order-summary-box" id="checkoutSummary" data-subtotal="@Model.CartTotal.ToString(CultureInfo.InvariantCulture)">
                <h2 class="h4">ملخص الطلب</h2>
                @foreach (var item in Model.CartItems)
                {
                    <div class="summary-item">
                        <img src="@item.ImageUrl" alt="@item.ProductName" class="summary-item-img" />
                        <div class="summary-item-details">@item.ProductName <small>الكمية: @item.Quantity</small></div>
                        <div>@item.SubTotal.ToString("0.00") د.ل</div>
                    </div>
                }
                <hr />
                <p>إجمالي المنتجات: @Model.CartTotal.ToString("0.00") د.ل</p>
                <p>التوصيل: <span id="shippingTotal">@(selectedRate == null ? "اختر المدينة" : selectedRate.Price.ToString("0.00") + " د.ل")</span></p>
                <p class="summary-total" aria-live="polite">الإجمالي مع التوصيل: <span id="orderTotal">@(selectedRate == null ? "اختر المدينة" : (Model.CartTotal + selectedRate.Price).ToString("0.00") + " د.ل")</span></p>
                <noscript>اختر المدينة وراجع تكلفة التوصيل الموضحة بجانبها؛ تُضاف هذه التكلفة إلى إجمالي المنتجات.</noscript>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/checkout.js" asp-append-version="true"></script>
}
