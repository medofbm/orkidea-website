@model CheckoutReceipt
@{
    ViewData["Title"] = "تم استلام طلبك!";
}

<section class="confirm-section">
    <div class="confirm-bg-decor" aria-hidden="true">
        <div class="confirm-circle confirm-circle-1"></div>
        <div class="confirm-circle confirm-circle-2"></div>
    </div>

    <div class="container py-5 position-relative text-center">
        <!-- أيقونة النجاح -->
        <div class="confirm-icon-wrap">
            <div class="confirm-icon">
                <i class="fas fa-circle-check" aria-hidden="true"></i>
            </div>
            <!-- تأثير الحلقات -->
            <div class="confirm-ring confirm-ring-1"></div>
            <div class="confirm-ring confirm-ring-2"></div>
        </div>

        <h1 class="confirm-title">شكراً لك! 🌸</h1>
        <p class="confirm-msg">تم استلام طلبك وحفظه برقم <strong data-testid="receipt-order-number">#@Model.OrderId</strong>.</p>
        @if (Model.Status == "Pending")
        {
            <p>طلبك بانتظار مراجعة التوفر والتجهيز؛ استلام الطلب لا يعني حجز الكمية بعد.</p>
        }
        <p>الحالة الحالية: <strong data-testid="receipt-status">@Model.StatusLabel</strong></p>

        <div class="confirm-card" aria-label="ملخص الطلب المحفوظ">
            <dl class="mb-0">
                <div class="confirm-card-row"><dt>رقم الطلب</dt><dd class="mb-0">#@Model.OrderId</dd></div>
                <div class="confirm-card-row"><dt>عدد القطع</dt><dd class="mb-0" data-testid="receipt-quantity">@Model.Quantity</dd></div>
                <div class="confirm-card-row"><dt>قيمة المنتجات</dt><dd class="mb-0" data-testid="receipt-products">@Model.ProductsTotal.ToString("0.00") د.ل</dd></div>
                <div class="confirm-card-row"><dt>أجرة التوصيل</dt><dd class="mb-0" data-testid="receipt-shipping">@Model.ShippingCost.ToString("0.00") د.ل</dd></div>
                <div class="confirm-card-row"><dt>الإجمالي شامل التوصيل</dt><dd class="mb-0" data-testid="receipt-total"><strong>@Model.TotalAmount.ToString("0.00") د.ل</strong></dd></div>
                <div class="confirm-card-row"><dt>تاريخ الطلب</dt><dd class="mb-0"><bdi>@Model.CreatedAtUtc.ToString("yyyy/MM/dd HH:mm") UTC</bdi></dd></div>
            </dl>
        </div>
        <p>احتفظ برقم الطلب للتواصل معنا. عرض هذا الملخص مرتبط بجلسة التصفح الحالية؛ الحالة لا تثبت تحصيل المبلغ.</p>

        <!-- بطاقة المعلومات -->
        <div class="confirm-card">
            <div class="confirm-card-row">
                <i class="fas fa-truck-fast" aria-hidden="true"></i>
                <span>تفاصيل التجهيز والتوصيل حسب مراجعة الطلب وحالته الحالية</span>
            </div>
            <div class="confirm-card-row">
                <i class="fas fa-wallet" aria-hidden="true"></i>
                <span>@(Model.PaymentMethod ?? "طريقة الدفع تحتاج إلى مراجعة")</span>
            </div>
            <div class="confirm-card-row">
                <i class="fab fa-whatsapp" aria-hidden="true"></i>
                <span>@Model.StatusLabel</span>
            </div>
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn confirm-home-btn btn-glowing">
            <i class="fas fa-house me-2" aria-hidden="true"></i>
            العودة للصفحة الرئيسية
        </a>
    </div>
</section>