@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="manage-inner">
    <div class="manage-inner-header">
        <div class="manage-inner-icon manage-inner-icon--purple">
            <i class="fas fa-lock" aria-hidden="true"></i>
        </div>
        <div>
            <h2 class="manage-inner-title">تغيير كلمة المرور</h2>
            <p class="manage-inner-sub">اختاري كلمة مرور قوية لا تشاركيها مع أحد</p>
        </div>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />
    <div asp-validation-summary="ModelOnly" class="manage-alert" role="alert"></div>

    <form id="change-password-form" method="post" class="manage-form">

        <div class="manage-field">
            <label asp-for="Input.OldPassword" class="manage-label">
                <i class="fas fa-key" aria-hidden="true"></i>
                كلمة المرور الحالية
            </label>
            <div class="manage-pw-wrap">
                <input asp-for="Input.OldPassword"
                       id="oldPw"
                       class="manage-input"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="••••••••"
                       type="password"
                       dir="ltr" />
                <button type="button" class="manage-eye-btn" onclick="togglePw('oldPw',this)" aria-label="إظهار/إخفاء">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Input.OldPassword" class="manage-error"></span>
        </div>

        <div class="manage-field">
            <label asp-for="Input.NewPassword" class="manage-label">
                <i class="fas fa-lock" aria-hidden="true"></i>
                كلمة المرور الجديدة
            </label>
            <div class="manage-pw-wrap">
                <input asp-for="Input.NewPassword"
                       id="newPw"
                       class="manage-input"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="••••••••"
                       type="password"
                       dir="ltr" />
                <button type="button" class="manage-eye-btn" onclick="togglePw('newPw',this)" aria-label="إظهار/إخفاء">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Input.NewPassword" class="manage-error"></span>
        </div>

        <div class="manage-field">
            <label asp-for="Input.ConfirmPassword" class="manage-label">
                <i class="fas fa-shield-halved" aria-hidden="true"></i>
                تأكيد كلمة المرور
            </label>
            <div class="manage-pw-wrap">
                <input asp-for="Input.ConfirmPassword"
                       id="confirmPw"
                       class="manage-input"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="••••••••"
                       type="password"
                       dir="ltr" />
                <button type="button" class="manage-eye-btn" onclick="togglePw('confirmPw',this)" aria-label="إظهار/إخفاء">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="manage-error"></span>
        </div>

        <button type="submit" class="btn manage-btn-primary btn-glowing">
            <i class="fas fa-shield-check me-2" aria-hidden="true"></i>
            تحديث كلمة المرور
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePw(id, btn) {
            const el = document.getElementById(id);
            if (el.type === 'password') { el.type = 'text'; btn.querySelector('i').className = 'fas fa-eye-slash'; }
            else { el.type = 'password'; btn.querySelector('i').className = 'fas fa-eye'; }
        }
    </script>
}
