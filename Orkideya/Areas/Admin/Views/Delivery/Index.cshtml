@using Orkideya.Application.Delivery
@model DeliveryIndexViewModel
@{
    ViewData["Title"] = "التوصيل والرواجع";
    var options = new[] { ("active", "الشحنات المفتوحة"), ("all", "كل الشحنات"), ("HandedOver", "مع جهة التوصيل"),
        ("Returning", "بانتظار الراجع"), ("Returned", "استلمنا الراجع"), ("Delivered", "استلمه العميل") };
}
<h1 class="h3">التوصيل والرواجع</h1>
<p>تابع التسليم والرواجع هنا. محفظة درب السبيل وتسوياتها في تطبيق الشركة؛ حالة الشحنة لا تثبت التحصيل.</p>
<form method="get" class="card-admin mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4"><label for="delivery-state" class="form-label">حالة التوصيل</label>
            <select id="delivery-state" name="state" class="form-select">
            @foreach (var option in options) { <option value="@option.Item1" selected="@(Model.State == option.Item1)">@option.Item2</option> }
            </select>
        </div>
        <div class="col-md-6"><label for="delivery-search" class="form-label">رقم الطلب، العميل، المدينة، الشركة أو مرجع الشحنة</label>
            <input id="delivery-search" name="search" value="@Model.Search" maxlength="100" class="form-control" />
        </div>
        <div class="col-md-2"><button type="submit" class="btn btn-primary">بحث</button></div>
    </div>
</form>
<div class="table-responsive card-admin">
<table class="table align-middle">
    <thead><tr><th>الطلب</th><th>العميل والمدينة</th><th>جهة التوصيل والمرجع</th><th>الحالة</th><th>آخر تحديث — UTC</th></tr></thead>
    <tbody>
    @foreach (var row in Model.Rows)
    {
        <tr><td><a asp-controller="Orders" asp-action="Details" asp-route-id="@row.OrderId">#@row.OrderId</a></td>
            <td>@row.CustomerName<br />@row.City</td><td>@(row.Mode == "Self" ? "توصيل ذاتي" : row.CarrierName)<br />@row.ShipmentReference</td>
            <td>@DeliveryLabels.State(row.State)</td><td>@row.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td></tr>
    }
    @if (Model.Rows.Count == 0) { <tr><td colspan="5">لا توجد شحنات مطابقة. تسجل الشحنة من تفاصيل الطلب بعد التجهيز.</td></tr> }
    </tbody>
</table>
</div>
<div class="d-flex flex-wrap gap-3 align-items-center mt-3">
    <span role="status">@Model.Total شحنة مطابقة — الصفحة @Model.Page من @Model.Pages</span>
    <nav aria-label="صفحات التوصيل">
    @if (Model.Page > 1) { <a class="btn btn-outline-secondary" asp-route-state="@Model.State" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)" rel="prev">السابق</a> }
    @if (Model.Page < Model.Pages) { <a class="btn btn-outline-secondary" asp-route-state="@Model.State" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)" rel="next">التالي</a> }
    </nav>
</div>
